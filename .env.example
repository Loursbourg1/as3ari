# Copy to .env.local and fill in. NEVER put service-role keys in VITE_ variables:
# everything prefixed with VITE_ is shipped to the browser.

# Supabase project (public values: URL + anon/publishable key). Leave empty to run in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map tiles. Default: OpenStreetMap standard tiles — fine for development and small demos under the
# OSM tile usage policy (https://operations.osmfoundation.org/policies/tiles/). For production traffic use a
# provider with an API key and a suitable plan (e.g. MapTiler, Stadia Maps, CARTO), and update the CSP in vercel.json.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Show synthetic demo records when connected to Supabase (they are always labelled "Demo").
VITE_SHOW_DEMO_DATA=false

# Google reCAPTCHA v2 / v3 (client-side site key). Leave empty to bypass during local development.
VITE_RECAPTCHA_SITE_KEY=

# --- Server-side only (Supabase Edge Function secrets, set with `supabase secrets set`) ---
# ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# RECAPTCHA_SECRET_KEY=your_google_recaptcha_secret_key
